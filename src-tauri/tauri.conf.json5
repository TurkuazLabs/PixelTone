// # 📄 Dosya Yolu: pixeltone/src-tauri/tauri.conf.json5
// # 📌 Amac: Tauri uygulama ve picker overlay ayarlarini tanimlamak
// # 📌 Config - JSON5
// # Version: 0.4.0
// # Aciklama: Ana pencere, seffaf picker overlay, build ve bundle ayarlarini tanimlar
//
// Bagimli Oldugu Katman: Config

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelTone",
  "version": "0.4.0",
  "identifier": "com.pixeltone.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PixelTone",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "picker",
        "title": "PixelTone Picker",
        "url": "picker.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "skipTaskbar": true,
        "shadow": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Platform independent color picker",
    "longDescription": "PixelTone is a platform independent color picker and palette manager built with Tauri, Rust and HTML UI."
  }
}
