// # 📄 Dosya Yolu: pixeltone/src-tauri/tauri.conf.json5
// # 📌 Amac: Tauri uygulama, splash ve picker overlay ayarlarini tanimlamak
// # 📌 Config - JSON5
// # Version: 1.1.1
// # Aciklama: Splash-first acilis, gizli ana pencere, picker overlay, signed updater, kullanici/tum kullanicilar kurulum secimi ve bundle ayarlarini tanimlar
//
// Bagimli Oldugu Katman: Config

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelTone",
  "version": "1.1.1",
  "identifier": "com.pixeltone.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PixelTone",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "PixelTone",
        "url": "splash.html",
        "width": 520,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "picker",
        "title": "PixelTone Picker",
        "url": "picker.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PIXELTONE_UPDATER_NOT_CONFIGURED",
      "endpoints": [
        "https://github.com/TurkuazLabs/PixelTone/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Platform independent color picker",
    "longDescription": "PixelTone is a platform independent color picker and palette manager built with Tauri, Rust and HTML UI.",
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "both",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "TurkuazLabs\\PixelTone",
        "template": "./windows/installer.nsi"
      }
    }
  }
}
