// # 📄 Dosya Yolu: pixeltone/src-tauri/tauri.conf.json5
// # 📌 Amac: Tauri uygulama ayarlarini tanimlamak
// # 📌 Config - JSON5
// # Version: 0.2.0
// # Aciklama: JSON5 secildi cunku header yorumlari valid kalir
//
// Bagimli Oldugu Katman: Config

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelTone",
  "version": "0.2.0",
  "identifier": "com.pixeltone.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PixelTone",
        "width": 1180,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Platform independent color picker",
    "longDescription": "PixelTone is a platform independent color picker and palette manager built with Tauri, Rust and HTML UI."
  }
}
