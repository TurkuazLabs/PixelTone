{
  "_pixeltone_header": {
    "dosya_yolu": "pixeltone/package.json",
    "amac": "Node, Vite, Tauri CLI, splash, Stable Desktop picker, updater ve Tailwind bagimliliklarini tanimlamak",
    "modul_filetype": "Config - JSON",
    "version": "1.2.1",
    "aciklama": "JSON yorum desteklemedigi icin header ilk nesne alani olarak tutulur",
    "bagimli_oldugu_katman": "Config"
  },
  "name": "pixeltone",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "PixelTone platform independent color picker and palette manager.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "tauri": "tauri",
    "check:version": "node tools/check_version_consistency.mjs",
    "check:release-context": "node tools/check_release_context.mjs",
    "check:release-lockfiles": "node tools/check_release_lockfiles.mjs",
    "preflight": "node tools/preflight.mjs",
    "preflight:release": "node tools/preflight.mjs --release",
    "test:tools": "node --test tests/*.test.mjs",
    "ci:windows": "powershell -ExecutionPolicy Bypass -File scripts/ci_windows.ps1",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/build_windows_setup.ps1",
    "check:updater": "node tools/check_updater_config.mjs",
    "configure:updater": "powershell -ExecutionPolicy Bypass -File scripts/configure_updater_signing.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "vite": "^6.0.0"
  }
}
